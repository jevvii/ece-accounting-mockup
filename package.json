{
  "name": "ece-accounting-mockup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ECE Accounting browser-local synthetic functional mockup",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "checkpoint": "node scripts/checkpoint.mjs",
    "seed:benchmark": "tsx scripts/seed-benchmark.ts",
    "benchmark": "tsx scripts/seed-benchmark.ts && playwright test -c playwright.benchmark.config.ts"
  },
  "dependencies": {
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
